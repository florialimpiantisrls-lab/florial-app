# Segreti di Florial TIA — vanno SOLO nei segreti di Supabase (Edge Functions → Secrets).
# ANTHROPIC_API_KEY c'è già: la usa la TIA attuale. Tutto il resto è facoltativo.

# Chi può usare TIA. All'inizio solo il titolare; poi si aggiungono ufficio e tecnico.
TIA_RUOLI=admin

TIA_MODELLO_PICCOLO=claude-haiku-5-5
TIA_MODELLO_GRANDE=claude-sonnet-5-5

# Tetti di token al giorno: oltre il primo TIA si ferma, oltre il secondo spegne solo il modello grande
TIA_TETTO_TOKEN_GIORNO=1500000
TIA_TETTO_TOKEN_GRANDE=300000
TIA_CACHE_GIORNI=7

# off = TIA legge e basta.  on = può preparare proposte che approvi tu.
TIA_SCRITTURA=off

# Siti da cui l'app può chiamare TIA (* = come le altre funzioni dell'app)
TIA_ORIGINI=*

# --- per dopo (NAS con AI a bordo) --------------------------------------------
TIA_LOCALE_URL=
TIA_LOCALE_MODELLO=
# Vettori: nessuno | supabase (gte-small, pensato per l'inglese) | ollama (modello multilingua sul NAS)
TIA_EMBEDDING=nessuno
TIA_EMBEDDING_URL=
TIA_EMBEDDING_MODELLO=
